# ---------------------------------------------------------------------------
# Global Buyer Export Dashboard - environment variables
# Copy this file to .env and fill in the keys you have. Never commit .env.
# ---------------------------------------------------------------------------

# Server
PORT=5001

# ---------------------------------------------------------------------------
# Gemini AI  (buyer classification)  -- YOU HAVE THIS KEY
# Get one at https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Live buyer discovery (optional)
# With no key, the app uses DuckDuckGo HTML results + live website scraping.
# With a Serper key it uses the Google Search API (more reliable).
# ---------------------------------------------------------------------------
SERPER_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ---------------------------------------------------------------------------
# Gmail sending (optional)
# Option A: Gmail API with OAuth refresh token (needs Google Cloud OAuth app)
# Option B: SMTP with a Gmail App Password (simplest): set SMTP_USER + SMTP_PASS
# With neither set, the app runs in DEMO send mode (emails are logged, not sent).
# ---------------------------------------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5001/api/outreach/oauth/callback
GMAIL_REFRESH_TOKEN=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

FROM_EMAIL=
FROM_NAME=Global Exports Team
