{
  "name": "global-buyer-export-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript full-stack buyer discovery and outreach dashboard for a home decor export business",
  "scripts": {
    "dev": "concurrently -n server,next -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "concurrently -k -n server,next -c cyan,magenta \"tsx server/index.ts\" \"npm --prefix client run start\"",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "setup": "npm install && npm --prefix client install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "multer": "^2.0.2",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
